{
  "name": "npm-publish-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Continuous monitoring of npm registry publications with multi-stage filtering (diploma project)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "db:reference": "node --env-file-if-exists=.env src/db/reference.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "db:docs": "node --env-file-if-exists=.env scripts/db-docs.mjs",
    "collector": "node --env-file-if-exists=.env src/collector/main.ts",
    "maintenance": "node --env-file-if-exists=.env src/maintenance/main.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "docs:pdf": "node documentation/build.mjs"
  },
  "dependencies": {
    "htm": "3.1.1",
    "postgres": "3.4.9",
    "preact": "11.0.1",
    "swagger-ui-dist": "5.33.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "marked": "18.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "typescript": "7.0.2"
  }
}
