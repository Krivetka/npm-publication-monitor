# Locally (DB from compose.dev.yml):
DATABASE_URL=postgres://npm_monitor:dev@127.0.0.1:55432/npm_monitor
# On the server — system PostgreSQL, one role per kind of process (deploy/db-roles.sql):
# DATABASE_URL_ADMIN=postgres://npm_monitor:<password>@127.0.0.1:5432/npm_monitor        # migrations
# DATABASE_URL=postgres://npm_monitor_write:<password>@127.0.0.1:5432/npm_monitor        # pipeline
# DATABASE_URL_WEB=postgres://npm_monitor_web:<password>@127.0.0.1:5432/npm_monitor      # API, dashboard
# Unset DATABASE_URL_ADMIN / DATABASE_URL_WEB fall back to DATABASE_URL.

# maintenance: retention of the privacy notice
# days after which the snapshot of a candidate without an alert is removed; 0 — off
RETENTION_EVIDENCE_DAYS=30
# ISO date after which alerts, their snapshots and verdicts are removed; empty — never
RETENTION_DELETE_ALL_AFTER=

# collector
FEED_URL=https://replicate.npmjs.com/registry
# empty — start from the current feed head on first run
FEED_START_SEQ=
FEED_BATCH_LIMIT=1000
FEED_POLL_INTERVAL_MS=5000
FEED_REQUEST_TIMEOUT_MS=30000

# stage 2: GitHub API token (fine-grained, public repositories only); without it 50 req/h
GITHUB_TOKEN=

# web UI (listens on 127.0.0.1, exposed by nginx or an ssh tunnel)
WEB_HOST=127.0.0.1
WEB_PORT=8090
WEB_BASE_PATH=/npm
WEB_TZ=Europe/Warsaw
# analyst bearer token for recording verdicts (PUT /api/v1/events/{seq}/finding); empty — writes refused
ANALYST_TOKEN=

LOG_LEVEL=info
